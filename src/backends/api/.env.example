# =============================================================================
# Biến môi trường backend — file DUY NHẤT cho phía server.
# Đọc bởi: API (src/backends/api), script DB (`pnpm db:migrate`, `db:seed`, `db:generate`,
# `db:studio`) và test e2e (`pnpm test`).
#
# Cách dùng: copy thành `.env` cùng thư mục (`cp .env.example .env`), sửa các giá trị
# [Bắt buộc]. API đọc file `.env` trong thư mục chạy (production: WorkingDirectory của
# systemd), script DB luôn đọc `src/backends/api/.env`.
# Biến đặt sẵn trong môi trường (systemd `EnvironmentFile`, shell) được ưu tiên hơn file.
# Dòng bắt đầu bằng `#` là tuỳ chọn: bỏ `#` để ghi đè giá trị mặc định ghi trong chú thích.
# Cấu hình sai sẽ làm API dừng ngay lúc khởi động kèm thông báo (kiểm tra bằng zod,
# xem src/config/env.ts).
#
# KHÔNG đặt ở đây: SMTP / Sendify, Google OAuth, Cloudflare Turnstile, tên site, cho phép
# đăng ký, bắt buộc 2FA… — các mục này nằm trong bảng `settings` của DB, sửa ở trang admin
# (Cài đặt hệ thống), xem docs/settings.md.
# =============================================================================

# ----- Chung -----------------------------------------------------------------
# Môi trường chạy: development | test | production. Mặc định: development.
# production bật cờ Secure cho cookie (xem COOKIE_SECURE) và cảnh báo khi HOST mở ra ngoài.
# NODE_ENV=production

# ----- Database --------------------------------------------------------------
# [Bắt buộc] Chuỗi kết nối PostgreSQL. Dùng chung cho API và script DB.
# Mật khẩu có ký tự đặc biệt phải mã hoá URL (ví dụ `@` → `%40`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_web

# ----- HTTP server -----------------------------------------------------------
# Cổng lắng nghe của API. Mặc định: 4000.
PORT=4000
# Địa chỉ lắng nghe. Mặc định: 0.0.0.0. Production nên đặt 127.0.0.1 để chỉ nginx gọi vào.
HOST=0.0.0.0
# Proxy được tin header IP (CF-Connecting-IP, X-Forwarded-For): IP hoặc CIDR, phân tách bằng dấu phẩy.
# Mặc định chỉ loopback (nginx / cloudflared / proxy Vite cùng máy). Request từ IP khác: dùng IP kết nối.
# Đứng sau Cloudflare + nginx cùng máy thì giữ mặc định; nginx / load balancer ở máy khác thì
# thêm IP hoặc dải của nó, ví dụ: 127.0.0.1,::1,10.0.0.0/8
# TRUSTED_PROXIES=127.0.0.1,::1

# ----- Redis (rate limit) ----------------------------------------------------
# Lưu bộ đếm giới hạn số lần thử (đăng nhập, 2FA, quên mật khẩu…). Bắt buộc khi chạy nhiều
# instance API. Bỏ trống = lưu trong bộ nhớ (chỉ đúng khi chạy 1 instance).
# Redis lỗi thì API vẫn chạy, tạm đếm trong bộ nhớ từng instance và ghi log.
# REDIS_URL=redis://127.0.0.1:6379/0
# Tiền tố key Redis, đổi khi nhiều app dùng chung 1 Redis. Mặc định: base-web:
# REDIS_KEY_PREFIX=base-web:

# ----- Bảo mật / token -------------------------------------------------------
# [Bắt buộc] Ký access token (JWT) và token tạm 2FA. Tối thiểu 32 ký tự, môi trường thật phải
# dùng chuỗi ngẫu nhiên: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Đổi giá trị này sẽ làm mọi access token đang dùng mất hiệu lực.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# [Bắt buộc] Mã hoá secret 2FA trong DB. Tối thiểu 32 ký tự, khác JWT_SECRET.
# Đổi key sẽ làm mất hiệu lực 2FA của mọi user.
ENCRYPTION_KEY=change-me-to-another-long-random-string-32-chars
# Thời hạn access token (định dạng 15m, 1h, 1d…). Mặc định: 15m.
ACCESS_TOKEN_TTL=15m
# Số ngày sống của refresh token (phiên đăng nhập), 1–365. Mặc định: 7.
REFRESH_TOKEN_TTL_DAYS=7
# Bật cờ Secure cho cookie refresh token: true | false (bắt buộc khi chạy HTTPS).
# Mặc định: true khi NODE_ENV=production, false khi khác.
# COOKIE_SECURE=true

# ----- Ứng dụng --------------------------------------------------------------
# Tên hiển thị trong ứng dụng Authenticator, email và hộp thoại passkey. Mặc định: Base Web.
# (Tên site hiển thị trên giao diện là setting `site_name` trong DB, không phải biến này.)
APP_NAME=Base Web
# [Bắt buộc ở production] URL trang user / admin, phải có scheme và không kèm dấu / ở cuối:
# tạo link trong email (xác minh email, đặt lại mật khẩu) và là origin hợp lệ cho passkey.
# Mặc định: http://localhost:5173 và http://localhost:5174.
USER_APP_URL=http://localhost:5173
ADMIN_APP_URL=http://localhost:5174
# Thư mục lưu file upload (avatar). Đường dẫn tương đối tính từ thư mục chạy API.
# Mặc định: storage/uploads. Production nên dùng đường dẫn tuyệt đối ngoài thư mục code,
# ví dụ /var/lib/base-web/uploads (user chạy API phải có quyền ghi).
UPLOAD_DIR=storage/uploads

# ----- Passkey (WebAuthn) ----------------------------------------------------
# Domain gốc gắn passkey — chỉ hostname, không kèm scheme, cổng hay đường dẫn.
# Bỏ trống = hostname của USER_APP_URL.
# User và admin ở 2 subdomain khác nhau thì đặt domain chung, ví dụ: example.com
# WEBAUTHN_RP_ID=example.com
# Tên hiển thị trong hộp thoại passkey. Mặc định: APP_NAME.
# WEBAUTHN_RP_NAME=Base Web
# Origin được phép thêm (ngoài USER_APP_URL / ADMIN_APP_URL), phân tách bằng dấu phẩy.
# WEBAUTHN_ORIGINS=https://app2.example.com

# ----- Lưu trữ ảnh sản phẩm (MinIO / S3) -------------------------------------
# Đặt đủ cả 3 biến MINIO_ENDPOINT, MINIO_ACCESS_KEY, MINIO_SECRET_KEY hoặc bỏ trống cả 3.
# Bỏ trống = tắt chức năng ảnh sản phẩm (bán hàng, nhập hàng… vẫn chạy bình thường).
# Chỉ đặt 1–2 biến thì API dừng khởi động và báo thiếu biến nào.
# Key/secret chỉ nằm ở server, không bao giờ gửi tới trình duyệt.
# Endpoint nội bộ API gọi vào (kiểm tra, xoá object), ví dụ: http://127.0.0.1:9000
# MINIO_ENDPOINT=http://localhost:9000
# Địa chỉ trình duyệt dùng để tải lên / xem ảnh (URL ký sẵn có hạn). Mặc định = MINIO_ENDPOINT.
# Production: domain riêng sau Cloudflare, ví dụ https://files.example.com (xem README).
# MINIO_PUBLIC_URL=https://files.example.com
# MINIO_ACCESS_KEY=
# MINIO_SECRET_KEY=
# Bucket private chứa ảnh (tạo sẵn hoặc API tự tạo khi khởi động ở môi trường dev). Mặc định: products.
# MINIO_BUCKET=products
# Region dùng khi ký URL. MinIO mặc định us-east-1.
# MINIO_REGION=us-east-1
# Dung lượng tối đa mỗi ảnh (byte), tối đa 52428800. Mặc định: 5242880 (5 MB).
# PRODUCT_IMAGE_MAX_BYTES=5242880

# ----- Tài liệu API (Swagger) ------------------------------------------------
# Bật Swagger UI tại /api/docs và JSON tại /api/docs-json: true | false.
# Mặc định: true, trừ khi NODE_ENV=production. Bật ở production thì nên chặn truy cập công khai.
# API_DOCS_ENABLED=false

# ----- Seed (chỉ dùng cho `pnpm db:seed`) ------------------------------------
# Tài khoản super admin tạo khi seed (bỏ qua nếu email đã tồn tại). Đổi mật khẩu ngay sau lần đầu.
# Bỏ trống = admin@example.com / Admin@123.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@123

# ----- Test (chỉ dùng cho `pnpm test`) ---------------------------------------
# Database cho test e2e — bị XOÁ và tạo lại mỗi lần chạy, nên user kết nối cần quyền
# CREATE/DROP DATABASE. Đừng trỏ vào DB có dữ liệu thật.
# Mặc định: DATABASE_URL với tên DB thêm hậu tố _test (ví dụ base_web_test).
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/base_web_test
# Redis cho test rate limit dùng Redis thật (nên chọn DB index riêng, dữ liệu sẽ bị ghi đè).
# Bỏ trống = bỏ qua các test này.
# TEST_REDIS_URL=redis://127.0.0.1:6379/15
